{
  "name": "maya-discord-bot",
  "version": "1.0.0",
  "description": "Discord Bot with Moderation, Music, and Gemini AI integration",
  "main": "dist/bot.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/bot.js",
    "dev": "nodemon --watch src -e ts,html,css,json --exec \"ts-node src/bot.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^2.3.0",
    "@prisma/client": "^5.14.0",
    "@snazzah/davey": "^0.1.12",
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "google-tts-api": "^2.0.2",
    "libsodium-wrappers": "^0.8.4",
    "msedge-tts": "^2.0.7",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "socket.io": "^4.8.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/socket.io": "^3.0.1",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
