{
  "name": "maya-discord-bot",
  "version": "1.0.0",
  "description": "Discord Bot with Moderation, Music, and Gemini AI integration",
  "main": "dist/bot.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/bot.js",
    "dev": "nodemon --watch src -e ts,html,css,json --exec ts-node src/bot.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.17.0",
    "@prisma/client": "^5.14.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "libsodium-wrappers": "^0.7.13",
    "play-dl": "^1.9.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/libsodium-wrappers": "^0.7.13",
    "@types/node": "^20.12.12",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
