datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model GuildConfig {
  guildId                String   @id
  welcomeChannelId       String?
  moderationLogChannelId  String?
  prefix                 String   @default("!")
  welcomeTitle           String   @default("👋 Selamat Datang!")
  welcomeMessage         String   @default("Selamat datang **{username}** di **{guildName}**!\n\nKamu adalah member ke-**{memberCount}** di server ini.\nJangan lupa untuk membaca aturan server dan bersenang-senang!")
  welcomeImage           String   @default("https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1000&auto=format&fit=crop&q=80")
  welcomeThumbnail       Boolean  @default(true)
  aiPersonality          String   @default("Anda adalah Maya, asisten AI pintar di server Discord ini. Jawablah pertanyaan dengan sopan, cerdas, dan membantu.")
  bannedWords            String   @default("anjing,babi,bangsat,kontol,memek,goblok,tolol,bajingan")
  maxStrikes             Int      @default(3)
  muteDuration           Int      @default(10)
  dailyRiddleChannelId   String?
  dailyRiddleEnabled     Boolean  @default(true)
  dailyRiddlePostHour    Int      @default(9)
  dailyLeaderboardPostHour Int    @default(21)
  dailyRiddleRewardAmount  Int    @default(10)
  dailyRiddleCloseRewardAmount Int @default(5)
  menfessChannelId       String?
  menfessEnabled         Boolean  @default(true)
  voiceRewardEnabled     Boolean  @default(true)
  voiceRewardIntervalMin Int      @default(10)
  voiceRewardAmount      Int      @default(5)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model WarnLog {
  id          Int      @id @default(autoincrement())
  userId      String
  guildId     String
  reason      String
  moderatorId String
  createdAt   DateTime @default(now())

  @@index([userId, guildId])
}

model GameSession {
  id           String   @id @default(uuid())
  guildId      String
  channelId    String
  messageId    String   @unique
  game         String
  description  String
  playTime     String
  maxPlayers   Int?
  gameUrl      String?
  creatorId    String
  participants String[]
  createdAt    DateTime @default(now())
}

model AiChatMessage {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  username  String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([guildId, userId])
}

model ReactionRoleMenu {
  id          String               @id @default(uuid())
  guildId     String
  channelId   String
  messageId   String?
  title       String               @default("🎭 Pilih Role Anda")
  description String               @default("Klik tombol di bawah untuk mengambil atau melepas role!")
  color       String               @default("#5865F2")
  options     ReactionRoleOption[]
  createdAt   DateTime             @default(now())
}

model ReactionRoleOption {
  id        String           @id @default(uuid())
  menuId    String
  menu      ReactionRoleMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  roleId    String
  roleName  String
  label     String
  emoji     String?
  style     String           @default("Primary")
}

model TriviaScore {
  id            Int      @id @default(autoincrement())
  guildId       String
  userId        String
  username      String
  score         Int      @default(0)
  dailyScore    Int      @default(0)
  lastDailyDate String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, score])
  @@index([guildId, dailyScore])
}

model MenfessLog {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  guildId     String
  channelId   String
  messageId   String
  senderId    String
  content     String
  replyToCode String?
  createdAt   DateTime @default(now())

  @@index([guildId, code])
}

model AnalyticsLog {
  id        Int      @id @default(autoincrement())
  guildId   String
  eventType String
  eventName String?
  hour      Int
  createdAt DateTime @default(now())

  @@index([guildId, eventType])
  @@index([guildId, createdAt])
}

model ShopItem {
  id          Int      @id @default(autoincrement())
  guildId     String
  title       String
  description String
  priceRtk    Int
  category    String   @default("GAME")
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([guildId, active])
}

model ShopOrder {
  id          Int      @id @default(autoincrement())
  orderId     String   @unique
  guildId     String
  userId      String
  username    String
  itemTitle   String
  priceRtk    Int
  targetInput String
  status      String   @default("PENDING")
  notes       String?
  createdAt   DateTime @default(now())

  @@index([guildId, status])
}



