datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model GuildConfig {
  guildId                String   @id
  welcomeChannelId       String?
  moderationLogChannelId  String?
  prefix                 String   @default("!")
  welcomeTitle           String   @default("👋 Selamat Datang!")
  welcomeMessage         String   @default("Selamat datang **{username}** di **{guildName}**!\n\nKamu adalah member ke-**{memberCount}** di server ini.\nJangan lupa untuk membaca aturan server dan bersenang-senang!")
  welcomeImage           String   @default("https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1000&auto=format&fit=crop&q=80")
  welcomeThumbnail       Boolean  @default(true)
  aiPersonality          String   @default("Anda adalah Maya, asisten AI pintar di server Discord ini. Jawablah pertanyaan dengan sopan, cerdas, dan membantu.")
  bannedWords            String   @default("anjing,babi,bangsat,kontol,memek,goblok,tolol,bajingan")
  maxStrikes             Int      @default(3)
  muteDuration           Int      @default(10)
  dailyRiddleChannelId   String?
  dailyRiddleEnabled     Boolean  @default(true)
  dailyRiddlePostHour    Int      @default(9)
  dailyLeaderboardPostHour Int    @default(21)
  dailyRiddleRewardAmount  Int    @default(10)
  dailyRiddleCloseRewardAmount Int @default(5)
  dailyPollChannelId     String?
  dailyPollEnabled       Boolean  @default(true)
  dailyPollPostHour      Int      @default(10)
  dailyPollRewardAmount  Int      @default(5)
  menfessChannelId       String?
  menfessEnabled         Boolean  @default(true)
  voiceRewardEnabled     Boolean  @default(true)
  voiceRewardIntervalMin Int      @default(10)
  voiceRewardAmount      Int      @default(5)
  storyChannelId         String?
  storyEnabled           Boolean  @default(true)
  storyStartHour         Int      @default(17)
  storyPublishHour       Int      @default(20)
  storyWordReward        Int      @default(10)
  storyMvpReward         Int      @default(250)
  lastRiddlePostDate     String?
  lastLeaderboardPostDate String?
  lastPollPostDate       String?
  lastStoryStartDate     String?
  lastStoryPublishDate   String?
  pantunEnabled          Boolean  @default(true)
  pantunChannelId        String?
  pantunStartHour        Int      @default(9)
  pantunCloseHour        Int      @default(23)
  pantunRewardAmount     Int      @default(15)
  pantunMvpReward        Int      @default(150)
  lastPantunStartDate    String?
  lastPantunCloseDate    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model DailyPantun {
  id           Int                    @id @default(autoincrement())
  guildId      String
  starterLines String
  theme        String?
  dateStr      String
  isActive     Boolean                @default(true)
  mvpUserId    String?
  mvpUsername  String?
  mvpPantun    String?
  mvpReason    String?
  createdAt    DateTime               @default(now())
  submissions  DailyPantunSubmission[]
}

model DailyPantunSubmission {
  id            Int         @id @default(autoincrement())
  dailyPantunId Int
  dailyPantun   DailyPantun @relation(fields: [dailyPantunId], references: [id], onDelete: Cascade)
  guildId       String
  userId        String
  username      String
  userAvatar    String?
  content       String
  dateStr       String
  createdAt     DateTime    @default(now())

  @@index([dailyPantunId])
  @@index([guildId, dateStr])
}

model WarnLog {
  id          Int      @id @default(autoincrement())
  userId      String
  guildId     String
  reason      String
  moderatorId String
  createdAt   DateTime @default(now())

  @@index([userId, guildId])
}

model GameSession {
  id             String   @id @default(uuid())
  guildId        String
  channelId      String
  messageId      String   @unique
  game           String
  description    String
  playTime       String
  gameUrl        String?
  maxPlayers     Int
  creatorId      String
  creatorName    String
  participantIds String   @default("[]")
  participants   String?  @default("[]")
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  @@index([guildId, status])
}

model ButtonRole {
  id          Int      @id @default(autoincrement())
  guildId     String
  channelId   String
  messageId   String   @unique
  title       String
  description String
  buttonJson  String
  createdAt   DateTime @default(now())

  @@index([guildId])
}

model ReactionRoleMenu {
  id          String               @id @default(uuid())
  guildId     String
  channelId   String
  messageId   String               @unique
  title       String
  description String
  color       String               @default("#5865F2")
  options     ReactionRoleOption[]
  createdAt   DateTime             @default(now())

  @@index([guildId])
}

model ReactionRoleOption {
  id        Int              @id @default(autoincrement())
  menuId    String
  menu      ReactionRoleMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  roleId    String
  roleName  String
  label     String
  emoji     String?
  style     String           @default("Primary")
  createdAt DateTime         @default(now())

  @@index([menuId])
}

model TriviaScore {
  id            Int      @id @default(autoincrement())
  guildId       String
  userId        String
  username      String
  score         Int      @default(0)
  dailyScore    Int      @default(0)
  lastDailyDate String?  @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, score])
}

model MenfessLog {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  guildId      String
  channelId    String?
  messageId    String?
  replyToCode  String?
  senderId     String
  targetUserId String?
  targetName   String?
  content      String
  aiFilterPass Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([guildId, code])
}

model MenfessReply {
  id        Int      @id @default(autoincrement())
  code      String
  guildId   String
  replierId String
  content   String
  createdAt DateTime @default(now())

  @@index([guildId, code])
}

model ShopItem {
  id          Int      @id @default(autoincrement())
  guildId     String
  title       String
  description String
  priceRtk    Int
  category    String   @default("GAME")
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([guildId, active])
}

model ShopOrder {
  id          Int      @id @default(autoincrement())
  orderId     String   @unique
  guildId     String
  userId      String
  username    String
  itemTitle   String
  priceRtk    Int
  targetInput String
  status      String   @default("PENDING")
  notes       String?
  createdAt   DateTime @default(now())

  @@index([guildId, status])
}

model DailyPoll {
  id          String          @id @default(uuid())
  guildId     String
  channelId   String
  messageId   String          @unique
  topic       String
  description String
  optionA     String
  optionB     String
  optionC     String?
  optionD     String?
  dateStr     String
  votes       DailyPollVote[]
  createdAt   DateTime        @default(now())

  @@index([guildId, dateStr])
}

model DailyPollVote {
  id           Int       @id @default(autoincrement())
  pollId       String
  poll         DailyPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId       String
  username     String
  optionChosen String
  createdAt    DateTime  @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
}

model AiChatMessage {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  username  String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([guildId])
}

model AnalyticsLog {
  id        Int      @id @default(autoincrement())
  guildId   String
  eventType String
  eventName String?
  hour      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([guildId, eventType])
}

model DailyStoryWord {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  username  String
  word      String
  dateStr   String
  createdAt DateTime @default(now())

  @@index([guildId, dateStr])
}

model DailyStory {
  id               String   @id @default(uuid())
  guildId          String
  title            String
  storyText        String
  imageUrl         String?
  mvpUserId        String?
  mvpUsername      String?
  mvpReason        String?
  contributorCount Int      @default(0)
  dateStr          String
  createdAt        DateTime @default(now())

  @@index([guildId, dateStr])
}
