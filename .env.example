# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Google Gemini AI Configuration (Free Tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA Build API Configuration (Optional Fallback)
# Get your free key at https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Database Configuration (PostgreSQL)
# Format for docker-compose: postgresql://<user>:<password>@<db_host>:<port>/<db_name>?schema=public
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/maya_db?schema=public"

# Optional config for production deployment
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://maya.rogatekno.my.id

# Web Dashboard (Backoffice) Authentication
DASHBOARD_PASSWORD=your_secret_passcode_here

# Spotify API Configuration (For Spotify Link Play Support)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
